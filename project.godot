; Engine configuration file.
; KAGURA ASCENT - 魔法少女 × 日本神話のローグライト縦スクロールSTG

config_version=5

[application]

config/name="KAGURA ASCENT"
config/description="八百万の神々から恩恵を受けて強くなる、魔法少女の縦スクロールSTG"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

general/default_playback_type.web=1

[display]

window/size/viewport_width=640
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/android/enable_long_press_as_right_click=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/hdr_2d=true
textures/vram_compression/import_etc2_astc=true
