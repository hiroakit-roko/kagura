; Engine configuration file.
; KAGURA ASCENT - 魔法少女 × 日本神話のローグライト縦スクロールSTG

config_version=5

[application]

config/name="KAGURA ASCENT"
config/description="八百万の神々から恩恵を受けて強くなる、魔法少女の縦スクロールSTG"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

run/max_fps=60

[audio]

; Web は Sample 再生だと iOS Safari で 10〜30 分後にページが落ちる既知の不具合（godot#116750）があるため Stream に
general/default_playback_type.web=0
; Stream 再生の音割れ対策で出力遅延を少し大きく
driver/output_latency.web=100

[display]

window/size/viewport_width=640
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/android/enable_long_press_as_right_click=false

[rendering]

; Web 向けにメモリとシェーダコンパイル時間を抑える（1 フレームの要素は数千で足りる）
limits/opengl/max_renderable_elements=16384
gl_compatibility/item_buffer_size=8192

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/hdr_2d=false
textures/vram_compression/import_etc2_astc=true
